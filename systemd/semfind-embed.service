[Unit]
Description=semfind: EmbeddingGemma 2 (GGUF Q8_0) per query e file nuovi, via llama.cpp
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@PREFIX@/vendor/llama/llama-server -m @DATA@/embeddinggemma-2-Q8_0.gguf --embeddings -c 1024 -b 1024 -ub 1024 -t 4 -np 1 --host 127.0.0.1 --port 47615 --no-webui --log-verbosity 1
Restart=on-failure
RestartSec=5
Nice=5
MemoryHigh=500M
MemoryMax=800M

[Install]
WantedBy=graphical-session.target
